# Copy to .env and fill in. Never commit .env.

# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Optional: your server's ID. Slash commands sync to it instantly
# (global sync can take a while). Enable Developer Mode in Discord,
# then right-click the server -> Copy Server ID.
# DISCORD_GUILD_ID=

# Any OpenAI-compatible endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Optional overrides
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=1
# LLM_MAX_TOKENS=
# SYSTEM_PROMPT=You are a friendly, concise assistant in a Discord server.
# CONTEXT_MESSAGES=20
# CONTEXT_MAX_CHARS=24000
# RATE_LIMIT_PER_MINUTE=5
# GLOBAL_RATE_LIMIT_PER_MINUTE=20

# Game Master mode
# GAME_ROUND_HOURS=24
# GAME_TARGET_ROUNDS=12
